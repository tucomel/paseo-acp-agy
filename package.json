{
  "name": "paseo-acp-agy",
  "version": "1.1.1",
  "description": "ACP (Agent Client Protocol) provider for Google Antigravity in Paseo and Zed",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "paseo-acp-agy": "dist/index.js",
    "agy-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PROTOCOL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout 15000",
    "start": "node dist/index.js"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "antigravity",
    "google-antigravity",
    "paseo",
    "zed",
    "coding-agent",
    "json-rpc"
  ],
  "author": "Arthur Melo <https://github.com/tucomel>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tucomel/paseo-acp-agy.git"
  },
  "bugs": {
    "url": "https://github.com/tucomel/paseo-acp-agy/issues"
  },
  "homepage": "https://github.com/tucomel/paseo-acp-agy#readme",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
